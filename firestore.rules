rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    match /users/{uid} { allow read, write: if self(uid); }
    match /public_profiles/{uid} { allow read: if signedIn(); allow create, update: if self(uid); allow delete: if false; }
    match /private_profiles/{uid} { allow read, write: if self(uid); }
    match /blocks/{uid}/items/{blockedUid} { allow read, write: if self(uid); }
    match /reports/{reportId} { allow create: if signedIn(); allow read, update, delete: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
