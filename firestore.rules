rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyKeys(keys) { return request.resource.data.keys().hasOnly(keys); }
    function immutableCreated() { return request.resource.data.createdAt == resource.data.createdAt; }
    match /users/{uid} {
      allow read: if self(uid);
      allow create: if self(uid)
        && onlyKeys(['uid', 'email', 'createdAt', 'updatedAt', 'onboardingCompleted', 'profileCompleted', 'emailVerified'])
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == request.time;
      allow update: if self(uid)
        && onlyKeys(['uid', 'email', 'createdAt', 'updatedAt', 'onboardingCompleted', 'profileCompleted', 'emailVerified'])
        && request.resource.data.uid == uid && resource.data.uid == uid
        && immutableCreated();
      allow delete: if false;
    }
    match /profiles/{uid} {
      allow read: if self(uid);
      allow create: if self(uid)
        && onlyKeys(['uid', 'displayName', 'bio', 'birthDate', 'age', 'city', 'photoUrls', 'personalityTraits', 'freeTimePreferences', 'attractionPreferences', 'datePreferences', 'conversationStyles', 'lifeGoals', 'weekendStyles', 'musicPreferences', 'travelStyles', 'connectionValues', 'personalAnswer', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == request.time;
      allow update: if self(uid)
        && onlyKeys(['uid', 'displayName', 'bio', 'birthDate', 'age', 'city', 'photoUrls', 'personalityTraits', 'freeTimePreferences', 'attractionPreferences', 'datePreferences', 'conversationStyles', 'lifeGoals', 'weekendStyles', 'musicPreferences', 'travelStyles', 'connectionValues', 'personalAnswer', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid && resource.data.uid == uid
        && immutableCreated();
      allow delete: if false;
    }
    match /preferences/{uid} {
      allow read: if self(uid);
      allow create, update: if self(uid)
        && onlyKeys(['uid', 'preferredAgeRange', 'preferredDistanceKm', 'preferredGender', 'relationshipIntent', 'discoveryEnabled', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid;
      allow delete: if false;
    }
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if self(uid)
        && onlyKeys(['uid', 'displayName', 'age', 'city', 'bio', 'photoUrls', 'personalityTraits', 'freeTimePreferences', 'datePreferences', 'conversationStyles', 'lifeGoals', 'musicPreferences', 'travelStyles', 'connectionValues', 'discoveryEnabled', 'updatedAt'])
        && request.resource.data.uid == uid;
      allow delete: if false;
    }
    match /private_profiles/{uid} { allow read, write: if self(uid); }
    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.blockerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['blockerUid', 'blockedUid', 'createdAt'])
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.blockerUid == request.auth.uid;
    }
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterUid', 'reportedUid', 'reason', 'details', 'createdAt', 'status'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.reason in ['harassment', 'inappropriateMessages', 'fakeProfile', 'sexualContent', 'threat', 'scam', 'inappropriatePhoto', 'spam', 'other']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /interactions/{interactionId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'type', 'specialInterestReason', 'createdAt', 'updatedAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.type in ['pass', 'like', 'specialInterest']
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.type == 'specialInterest' && request.resource.data.specialInterestReason in ['personality','humor','music','lifestyle','profileEnergy','overall']) || (request.resource.data.type != 'specialInterest' && !('specialInterestReason' in request.resource.data)));
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn() && resource.data.fromUid == request.auth.uid
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /matches/{matchId} {
      allow read: if signedIn() && (resource.data.userAUid == request.auth.uid || resource.data.userBUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userAUid', 'userBUid', 'createdAt', 'updatedAt', 'status'])
        && request.resource.data.status == 'active'
        && request.resource.data.userAUid < request.resource.data.userBUid
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.userAUid + '_' + request.resource.data.userBUid))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.userBUid + '_' + request.resource.data.userAUid))
        && get(/databases/$(database)/documents/interactions/$(request.resource.data.userAUid + '_' + request.resource.data.userBUid)).data.type in ['like','specialInterest']
        && get(/databases/$(database)/documents/interactions/$(request.resource.data.userBUid + '_' + request.resource.data.userAUid)).data.type in ['like','specialInterest'];
      allow update, delete: if false;
    }
    match /conversations/{conversationId} {
      allow read: if signedIn()
        && (resource.data.userAUid == request.auth.uid || resource.data.userBUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userAUid', 'userBUid', 'matchId', 'lastMessagePreview', 'createdAt', 'updatedAt'])
        && request.resource.data.userAUid is string
        && request.resource.data.userBUid is string
        && request.resource.data.userAUid != ''
        && request.resource.data.userBUid != ''
        && request.resource.data.userAUid < request.resource.data.userBUid
        && (request.resource.data.userAUid == request.auth.uid || request.resource.data.userBUid == request.auth.uid)
        && request.resource.data.matchId == conversationId
        && conversationId == request.resource.data.userAUid + '_' + request.resource.data.userBUid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/matches/$(conversationId))
        && get(/databases/$(database)/documents/matches/$(conversationId)).data.status == 'active'
        && get(/databases/$(database)/documents/matches/$(conversationId)).data.userAUid == request.resource.data.userAUid
        && get(/databases/$(database)/documents/matches/$(conversationId)).data.userBUid == request.resource.data.userBUid
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.userAUid + '_' + request.resource.data.userBUid))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.userBUid + '_' + request.resource.data.userAUid))
        && (!('lastMessagePreview' in request.resource.data) || request.resource.data.lastMessagePreview is string);
      allow update, delete: if false;
    }
    match /discoverySessions/{sessionId} {
      function isDiscoveryParticipant() {
        return signedIn()
          && (resource.data.userAUid == request.auth.uid
            || resource.data.userBUid == request.auth.uid);
      }
      function immutableDiscoveryFields() {
        return request.resource.data.keys().hasOnly(['userAUid', 'userBUid', 'status', 'questionIds', 'currentQuestionIndex', 'userAWantsReveal', 'userBWantsReveal', 'createdAt', 'updatedAt'])
          && request.resource.data.userAUid == resource.data.userAUid
          && request.resource.data.userBUid == resource.data.userBUid
          && request.resource.data.questionIds == resource.data.questionIds
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.userAWantsReveal == resource.data.userAWantsReveal
          && request.resource.data.userBWantsReveal == resource.data.userBWantsReveal
          && request.resource.data.updatedAt == request.time;
      }
      function activeQuestionHasBothAnswers() {
        return exists(/databases/$(database)/documents/discoverySessions/$(sessionId)/answers/$(resource.data.questionIds[resource.data.currentQuestionIndex] + '_' + resource.data.userAUid))
          && exists(/databases/$(database)/documents/discoverySessions/$(sessionId)/answers/$(resource.data.questionIds[resource.data.currentQuestionIndex] + '_' + resource.data.userBUid));
      }
      function validQuestionProgression() {
        return resource.data.status == 'questions'
          && activeQuestionHasBothAnswers()
          && ((resource.data.currentQuestionIndex == 0
              && request.resource.data.status == 'questions'
              && request.resource.data.currentQuestionIndex == 1)
            || (resource.data.currentQuestionIndex == 1
              && request.resource.data.status == 'questions'
              && request.resource.data.currentQuestionIndex == 2)
            || (resource.data.currentQuestionIndex == 2
              && request.resource.data.status == 'hiddenChat'
              && request.resource.data.currentQuestionIndex == 2));
      }
      allow read: if signedIn()
        && (resource.data.userAUid == request.auth.uid || resource.data.userBUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userAUid', 'userBUid', 'status', 'questionIds', 'currentQuestionIndex', 'userAWantsReveal', 'userBWantsReveal', 'createdAt', 'updatedAt'])
        && request.resource.data.userAUid is string
        && request.resource.data.userBUid is string
        && request.resource.data.userAUid != ''
        && request.resource.data.userBUid != ''
        && request.resource.data.userAUid != request.resource.data.userBUid
        && request.resource.data.userAUid < request.resource.data.userBUid
        && (request.resource.data.userAUid == request.auth.uid || request.resource.data.userBUid == request.auth.uid)
        && sessionId == request.resource.data.userAUid + '_' + request.resource.data.userBUid
        && request.resource.data.status == 'questions'
        && request.resource.data.currentQuestionIndex == 0
        && request.resource.data.userAWantsReveal == false
        && request.resource.data.userBWantsReveal == false
        && request.resource.data.questionIds is list
        && request.resource.data.questionIds.size() == 3
        && request.resource.data.questionIds[0] is string
        && request.resource.data.questionIds[1] is string
        && request.resource.data.questionIds[2] is string
        && request.resource.data.questionIds[0] != ''
        && request.resource.data.questionIds[1] != ''
        && request.resource.data.questionIds[2] != ''
        && request.resource.data.questionIds[0] != request.resource.data.questionIds[1]
        && request.resource.data.questionIds[0] != request.resource.data.questionIds[2]
        && request.resource.data.questionIds[1] != request.resource.data.questionIds[2]
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isDiscoveryParticipant()
        && immutableDiscoveryFields()
        && validQuestionProgression();
      allow delete: if false;
    }
    match /discoverySessions/{sessionId}/answers/{answerId} {
      function session() {
        return get(/databases/$(database)/documents/discoverySessions/$(sessionId)).data;
      }
      function isParticipant() {
        return signedIn()
          && (session().userAUid == request.auth.uid || session().userBUid == request.auth.uid);
      }
      allow read: if isParticipant()
        && (resource.data.userUid == request.auth.uid
          || exists(/databases/$(database)/documents/discoverySessions/$(sessionId)/answers/$(resource.data.questionId + '_' + request.auth.uid)));
      allow create: if isParticipant()
        && request.resource.data.keys().hasOnly(['sessionId', 'questionId', 'userUid', 'text', 'createdAt'])
        && request.resource.data.sessionId == sessionId
        && request.resource.data.questionId is string
        && request.resource.data.questionId == session().questionIds[session().currentQuestionIndex]
        && request.resource.data.userUid == request.auth.uid
        && answerId == request.resource.data.questionId + '_' + request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time
        && session().status == 'questions';
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
